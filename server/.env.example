# Server
PORT=5000
NODE_ENV=production

# JWT - GENERATE A STRONG SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_BYTES

# Admin credentials (only used on first run to seed the admin user)
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# Frontend URL (for CORS) - comma separated if multiple
# In production with same-origin serving, use the production domain
FRONTEND_URL=https://xybooster.info
